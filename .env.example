# PostgreSQL
POSTGRES_DB=legal_rag
POSTGRES_USER=legal_rag
POSTGRES_PASSWORD=legal_rag_dev_password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://legal_rag:legal_rag_dev_password@127.0.0.1:5432/legal_rag

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_COLLECTION=legal_paragraphs

# Embeddings
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
EMBEDDING_BATCH_SIZE=64

# Cross-encoder reranking
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L6-v2
RERANKER_BATCH_SIZE=16
RERANKER_CANDIDATE_K=30
RERANKER_TOP_K=10

# Grounded answer generation (leave the key empty to keep /search available
# while /answer and cited /verify requests report provider unavailability)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# Optional; falls back to OPENAI_MODEL when empty.
OPENAI_VERIFIER_MODEL=
OPENAI_TIMEOUT_SECONDS=60
